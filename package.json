{
  "name": "athena",
  "version": "1.0.0",
  "description": "Rose-style Telegram group management bot with an /ask AI command, deployed on Vercel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx scripts/dev-poll.ts",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "del-webhook": "tsx scripts/set-webhook.ts --delete",
    "set-commands": "tsx scripts/set-commands.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
