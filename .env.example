# --- Required: Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random secret (A-Za-z0-9_-) you invent; setWebhook sends it back on every update
WEBHOOK_SECRET=

# --- Required: Upstash Redis (console.upstash.com -> REST API credentials) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Required: OpenRouter (openrouter.ai -> Keys) ---
OPENROUTER_API_KEY=
# Free model slugs rotate often; check https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Optional ---
# Per-user /ask calls per day in groups (admins exempt). Default: 10
ASK_DAILY_LIMIT=10
# Your deployed URL, used by `npm run set-webhook` if not passed as an argument
PUBLIC_BASE_URL=
