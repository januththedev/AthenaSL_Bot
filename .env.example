# --- Required: Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random secret (A-Za-z0-9_-) you invent; setWebhook sends it back on every update
WEBHOOK_SECRET=

# --- Required (production): Neon Postgres ---
# Easiest: Vercel → your project → Storage → Create Database → Neon.
# The integration injects POSTGRES_URL automatically; a manual Neon
# connection string works too (DATABASE_URL).
POSTGRES_URL=

# --- Required: OpenRouter (openrouter.ai -> Keys) ---
# Key 1; add up to 4 keys as separate env vars — rotated automatically
# when one is rate-limited or rejected. Each key's daily quota is separate.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
# Free model slugs rotate often; check https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=minimax/minimax-m2.7:free
# Used automatically when the primary is rate-limited or returns junk
OPENROUTER_MODEL_FALLBACK=google/gemma-4-31b-it:free

# --- Optional: Groq (console.groq.com -> API Keys) ---
# Second provider in the chain; its compound model adds web search and
# python code execution, used automatically for questions that need them.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_COMPOUND_MODEL=groq/compound

# --- Optional ---
# Per-user /ask calls per day in groups (admins exempt). Default: 10
ASK_DAILY_LIMIT=10
# Your deployed URL, used by `npm run set-webhook` if not passed as an argument
PUBLIC_BASE_URL=
# Protects /api/cron (reminders + exam countdowns). Vercel Cron sends it automatically.
CRON_SECRET=
# Set to 1 to store data in LOCAL_STORE_PATH (JSON file) instead of Postgres (local dev only)
USE_LOCAL_STORE=0
LOCAL_STORE_PATH=data/dev-store.json
